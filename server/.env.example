# LLM API配置
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 文本对话模型（用于回答种植问题）
LLM_MODEL=glm-4.7

# 视觉模型（用于分析植物照片）
LLM_VISION_MODEL=glm-4.6v

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 模型存储目录（统一管理所有AI模型）
MODELS_DIR=/path/to/models
FUNASR_MODEL_DIR=/path/to/models/funasr
COQUI_MODEL_DIR=/path/to/models/tts

# FunASR配置
FUNASR_DEVICE=cuda  # cuda 或 cpu
FUNASR_MODEL=paraformer-zh

# TTS配置 - Coqui TTS（离线本地）
# 设置为true使用本地Coqui TTS，false不使用语音合成
USE_COQUI_TTS=true

# Coqui TTS配置
# 模型选项：
#   - tts_models/zh-CN/baker/glow-tts
#   - tts_models/zh-CN/baker/tacotron2-DDC-GST
COQUI_MODEL_NAME=tts_models/zh-CN/baker/tacotron2-DDC-GST
COQUI_USE_GPU=true  # 是否使用GPU加速

# WebSocket安全配置
# ⚠️ 重要: 生产环境请使用强密码！
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
WS_TOKEN=your-secret-token-change-me-in-production

# ========== 聊天模式配置 ==========

# 默认聊天模式
# 可选值:
#   - fast: 快速模式，仅根据当前输入回复，响应最快
#   - thinking: 思考模式，结合历史聊天记录，理解上下文
#   - expert: 专家模式，多Agent协作，获取位置/天气/时间等信息
DEFAULT_CHAT_MODE=fast

# 聊天历史记录数量
# 用于思考模式和专家模式，控制加载多少条历史记录
# 建议范围: 10-50，数值越大上下文越完整，但消耗token越多
CHAT_HISTORY_LIMIT=20

# 专家模式配置
EXPERT_MODE_ENABLED=true  # 是否启用专家模式

# 默认位置配置（用于IP定位失败时的fallback）
DEFAULT_CITY=北京
DEFAULT_LAT=39.9042
DEFAULT_LON=116.4074

# ========== 天气API配置 ==========
# 天气数据获取方式
# WEATHER_USE_MCP: false=直接调用WTTR.in API（推荐，简单快速）
#                  true=通过自建MCP服务器获取天气（适合需要标准化的场景）
WEATHER_USE_MCP=true

# MCP服务器启动命令（仅在WEATHER_USE_MCP=true时使用）
# 使用Python模块方式运行MCP服务器
WEATHER_MCP_COMMAND=python -m app.services.mcp.weather_server

# 说明：
# - API方式（默认）：直接调用WTTR.in，性能更好，延迟更低
# - MCP方式：通过MCP协议调用，适合需要统一工具管理的场景
# - 推荐大多数用户使用API方式（WEATHER_USE_MCP=false）

